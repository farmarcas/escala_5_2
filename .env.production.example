# Variáveis do Coolify (aba "Environment Variables" da aplicação). Aqui só os NOMES: nunca coloque valores reais no Git.

# Banco: copie a "Postgres URL (internal)" do banco criado no Coolify.
DATABASE_URL=

# Endereço público do site, com https (ex.: https://radarescala.farmarcas.com.br).
APP_BASE_URL=

# E-mail (SMTP da Farmarcas). 587 usa STARTTLS; 465 usa conexão segura direta.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# MAIL_SECURE=

# Chave da equipe para consultar contatos (mínimo 16 caracteres, aleatória).
ADMIN_API_KEY=

# Quantos proxies existem na frente da API (Coolify + tela = 2).
TRUST_PROXY=2

# Análise com IA (opcional). Sem a chave, o botão "Analisar com IA" não aparece.
ANTHROPIC_API_KEY=
