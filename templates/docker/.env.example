# Copie para .env (cp .env.example .env). Nunca faça commit do .env.
# Valores abaixo servem só para ambiente local. As portas só aceitam conexões deste computador.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Portas no seu computador. Mude se alguma estiver ocupada.
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

# Caixa de e-mail de teste (Mailpit): abra http://localhost:8025 para ver os e-mails enviados.
MAILPIT_UI_PORT=8025
MAIL_FROM=Farmarcas <nao-responda@farmarcas.local>

# Chave da equipe da Farmarcas para consultar contatos da calculadora. Valor local de teste: troque em produção.
ADMIN_API_KEY=troque-esta-chave-local
