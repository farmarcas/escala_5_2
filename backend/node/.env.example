# Só para rodar fora do Docker (o caminho padrão é o Compose, que já define tudo isso).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://app:app@localhost:5432/app
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Farmarcas <nao-responda@farmarcas.local>
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
ADMIN_API_KEY=troque-esta-chave-local

# Análise com IA (opcional): sem a chave, o assistente fica desligado.
ANTHROPIC_API_KEY=
