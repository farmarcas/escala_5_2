generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

// PK: UUIDv7 gerado pela aplicação (decisão documentada em database/DATABASE.md).
// Exclusão lógica: deleted_at. O e-mail é único só entre registros ativos; esse índice
// parcial vive no SQL da migration (o Prisma não declara índice parcial no schema).
enum TaxRegime {
  real
  presumido
  simples
}

enum ContactSource {
  consultor
  pdf
}

enum ContactMode {
  rapido
  detalhado
}

// Painel de Escalas (spec 004). Tabelas próprias: o produto antigo (stores/simulations) sai na última fatia.
enum ScaleTaxRegime {
  simples
  lucro_presumido_real
}

enum ScaleRole {
  farmaceutico
  gerente
  subgerente
  balconista
  caixa
  perfumista
  servicos_gerais
  entregador
  comprador
  conferente
  atendente_digital
  expedicao
}

enum ScaleType {
  normal
  doze_x_trinta_e_seis
}

enum CoverageMode {
  all
  band
}

enum EmailTokenKind {
  verify
  reset
}

// Grupo de farmácias: tudo que o gestor cadastra pertence a um grupo e só ele enxerga.
model Group {
  id            String      @id @default(uuid(7)) @db.Uuid
  name          String
  taxRegime     TaxRegime   @default(real) @map("tax_regime")
  annualRevenue Decimal?    @map("annual_revenue") @db.Decimal(16, 2)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users         User[]
  scaleStores   ScaleStore[]

  @@map("groups")
}

// Conta de quem usa o modo detalhado. Colunas novas ficam opcionais no banco (expand): o esqueleto
// antigo tinha linhas sem senha/grupo; a API exige todas elas no cadastro.
model User {
  id                String       @id @default(uuid(7)) @db.Uuid
  name              String
  email             String
  groupId           String?      @map("group_id") @db.Uuid
  passwordHash      String?      @map("password_hash")
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  privacyAcceptedAt DateTime?    @map("privacy_accepted_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  group             Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions          Session[]
  emailTokens       EmailToken[]

  @@index([groupId])
  @@map("users")
}

// Só o hash (SHA-256) do token do cookie vai ao banco.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

// Pedido de contato / lead de PDF. Não depende de conta. Dados pessoais podem ser anonimizados a pedido
// do titular (LGPD): os campos pessoais são apagados e `anonymized_at` marca quando.
model ContactRequest {
  id                String        @id @default(uuid(7)) @db.Uuid
  source            ContactSource
  mode              ContactMode
  name              String
  roleTitle         String        @map("role_title")
  company           String
  phone             String
  email             String
  sector            String?
  privacyAcceptedAt DateTime      @map("privacy_accepted_at") @db.Timestamptz(3)
  profile           Json
  result            Json
  idempotencyKey    String        @unique @map("idempotency_key")
  utm               String?
  anonymizedAt      DateTime?     @map("anonymized_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("contact_requests")
}

// Loja do Painel de Escalas. `config` guarda os passos 2, 3, 5, 6 e 7 (horário, plantão, regras, vendas, feriados)
// em JSON versionado e validado por Zod: é sempre lido e gravado junto e nunca consultado por dentro.
// Nome único entre lojas ativas do grupo (índice parcial no SQL da migration).
model ScaleStore {
  id             String          @id @default(uuid(7)) @db.Uuid
  groupId        String          @map("group_id") @db.Uuid
  name           String
  city           String
  state          String          @db.Char(2)
  scaleStartDate DateTime        @map("scale_start_date") @db.Date
  taxRegime      ScaleTaxRegime  @default(simples) @map("tax_regime")
  config         Json            @default("{}")
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles          ScaleStoreRole[]

  @@index([groupId, deletedAt])
  @@map("scale_stores")
}

// Equipe por função. Gerente e subgerente são funções separadas (quantidade e salário próprios) e a tela
// as junta no quadro. `band_start`/`band_end` valem quando a cobertura é por faixa de horário ("HH:MM").
model ScaleStoreRole {
  id                String       @id @default(uuid(7)) @db.Uuid
  storeId           String       @map("store_id") @db.Uuid
  role              ScaleRole
  enabled           Boolean      @default(true)
  headcount         Int          @db.SmallInt
  monthlySalary     Decimal      @map("monthly_salary") @db.Decimal(12, 2)
  scaleType         ScaleType    @default(normal) @map("scale_type")
  minInHall         Int          @default(1) @map("min_in_hall") @db.SmallInt
  coverageMode      CoverageMode @default(all) @map("coverage_mode")
  bandStart         String?      @map("band_start")
  bandEnd           String?      @map("band_end")
  daysMask          Int          @default(127) @map("days_mask") @db.SmallInt
  ownerIsPharmacist Boolean      @default(false) @map("owner_is_pharmacist")
  motorcycle        Boolean      @default(false)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  store             ScaleStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, role])
  @@map("scale_store_roles")
}
