generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

// PK: UUIDv7 gerado pela aplicação (decisão documentada em database/DATABASE.md).
// Exclusão lógica: deleted_at. O e-mail é único só entre registros ativos; esse índice
// parcial vive no SQL da migration (o Prisma não declara índice parcial no schema).
enum TaxRegime {
  real
  presumido
  simples
}

enum StoreProfile {
  rua
  shopping
  h24 @map("24h")
}

enum StoreSize {
  pequena
  media
  grande
}

enum StoreRoleKind {
  farmaceutico
  balconista
  caixa
  estoquista
}

enum ContactSource {
  consultor
  pdf
}

enum ContactMode {
  rapido
  detalhado
}

enum EmailTokenKind {
  verify
  reset
}

// Grupo de farmácias: tudo que o gestor cadastra pertence a um grupo e só ele enxerga.
model Group {
  id            String      @id @default(uuid(7)) @db.Uuid
  name          String
  taxRegime     TaxRegime   @default(real) @map("tax_regime")
  annualRevenue Decimal?    @map("annual_revenue") @db.Decimal(16, 2)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users         User[]
  stores        Store[]
  simulations   Simulation[]

  @@map("groups")
}

// Conta de quem usa o modo detalhado. Colunas novas ficam opcionais no banco (expand): o esqueleto
// antigo tinha linhas sem senha/grupo; a API exige todas elas no cadastro.
model User {
  id                String       @id @default(uuid(7)) @db.Uuid
  name              String
  email             String
  groupId           String?      @map("group_id") @db.Uuid
  passwordHash      String?      @map("password_hash")
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  privacyAcceptedAt DateTime?    @map("privacy_accepted_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  group             Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions          Session[]
  emailTokens       EmailToken[]
  simulations       Simulation[]

  @@index([groupId])
  @@map("users")
}

// Só o hash (SHA-256) do token do cookie vai ao banco.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

// Nome único entre lojas ativas do grupo (índice parcial no SQL da migration).
// opening_hours: [{ weekday: 0..6, opensAt: "08:00", closesAt: "22:00" | "24:00" }]; dia ausente = fechado.
model Store {
  id           String       @id @default(uuid(7)) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  name         String
  city         String
  profile      StoreProfile
  // Porte informado pelo dono; nulo nas lojas cadastradas antes desta coluna existir.
  size         StoreSize?
  openingHours Json         @map("opening_hours")
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles        StoreRole[]

  @@index([groupId, deletedAt])
  @@map("stores")
}

model StoreRole {
  id            String        @id @default(uuid(7)) @db.Uuid
  storeId       String        @map("store_id") @db.Uuid
  role          StoreRoleKind
  // Opcional: sem ele, o quadro atual é a necessidade da função (cobertura constante).
  minPerShift   Int?          @map("min_per_shift") @db.SmallInt
  headcount     Int           @db.SmallInt
  weeklyHours   Decimal       @map("weekly_hours") @db.Decimal(4, 1)
  monthlySalary Decimal       @map("monthly_salary") @db.Decimal(12, 2)
  absenceRate   Decimal?      @map("absence_rate") @db.Decimal(4, 3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, role])
  @@map("store_roles")
}

// Foto imutável de uma simulação: premissas, lojas, ações e resultado do momento em que foi salva.
// JSON de propósito: editar loja ou premissa depois NÃO pode mudar uma simulação antiga (FR-018).
// Nome único entre simulações ativas do grupo (índice parcial no SQL da migration).
model Simulation {
  id          String    @id @default(uuid(7)) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  name        String
  premises    Json
  input       Json
  mitigations Json
  result      Json
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt(sort: Desc)])
  @@map("simulations")
}

// Pedido de contato / lead de PDF. Não depende de conta. Dados pessoais podem ser anonimizados a pedido
// do titular (LGPD): os campos pessoais são apagados e `anonymized_at` marca quando.
model ContactRequest {
  id                String        @id @default(uuid(7)) @db.Uuid
  source            ContactSource
  mode              ContactMode
  name              String
  roleTitle         String        @map("role_title")
  company           String
  phone             String
  email             String
  sector            String?
  privacyAcceptedAt DateTime      @map("privacy_accepted_at") @db.Timestamptz(3)
  profile           Json
  result            Json
  idempotencyKey    String        @unique @map("idempotency_key")
  utm               String?
  anonymizedAt      DateTime?     @map("anonymized_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("contact_requests")
}
